---
import { projects } from '../data/projects';

const base = `${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, '/');

const labels = ['测绘', '地信', '遥感', '荒野行者', '股市小白'];

const visitedCities = [
  '武汉市', '黄石市', '宜昌市', '咸宁市',
  '南京市', '苏州市', '徐州市', '连云港市', '淮安市', '扬州市', '泰州市',
  '北京市',
  '运城市', '晋中市', '临汾市', '晋城市', '忻州市',
  '延安市', '汉中市', '西安市',
  '石家庄市',
  '济宁市', '临沂市', '枣庄市', '泰安市', '青岛市',
  '陇南市', '甘南藏族自治州', '酒泉市', '张掖市', '兰州市',
  '阿坝藏族羌族自治州',
  '香港特别行政区',
  '深圳市',
  '开封市', '郑州市', '洛阳市', '新乡市',
  '台州市', '杭州市',
  '上饶市', '南昌市', '萍乡市',
  '重庆市',
  '宿州市', '阜阳市', '淮北市', '六安市', '合肥市',
  '海西蒙古族藏族自治州', '海北藏族自治州', '西宁市', '海东市',
  '长沙市',
];

const siteUrl = 'https://3323098520.github.io/portfolio/';
const ogImage = `${siteUrl}og.png`;
const avatarUrl = `${base}avatar.jpg`;
const wechatUrl = `${base}wechat-contact.png`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="个人基本信息与项目链接展示。" />
		<link rel="canonical" href={siteUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="个人主页" />
		<meta property="og:description" content="个人基本信息与项目链接展示。" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="个人主页" />
		<meta name="twitter:description" content="个人基本信息与项目链接展示。" />
		<meta name="twitter:image" content={ogImage} />
		<title>个人主页</title>
	</head>
	<body>
		<main>
			<header>
				<div class="identity">
					<img class="avatar" src={avatarUrl} alt="暮春十九的微信头像" width="940" height="940" />
					<div>
						<p class="label">PERSONAL PAGE</p>
						<h1>暮春十九✨</h1>
						<p class="intro">27届研究生，户外爱好者。</p>
					</div>
				</div>
				<a class="github" href="https://github.com/3323098520" target="_blank" rel="noreferrer">GitHub ↗</a>
			</header>

			<nav class="tabs" role="tablist" aria-label="页面内容">
				<button class="tab" type="button" role="tab" id="home-tab" aria-controls="home-panel" aria-selected="true" data-tab="home">首页</button>
				<button class="tab" type="button" role="tab" id="about-tab" aria-controls="about-panel" aria-selected="false" data-tab="about">关于</button>
				<button class="tab" type="button" role="tab" id="contact-tab" aria-controls="contact-panel" aria-selected="false" data-tab="contact">联系我</button>
			</nav>

			<section class="tab-panel" id="home-panel" role="tabpanel" aria-labelledby="home-tab">
				<h2 id="projects-title">项目</h2>
				<div class="project-list">
					{projects.map((project, index) => (
						<a class="project" href={`${base}projects/${project.slug}/`}>
							<span class="number">0{index + 1}</span>
							<span class="project-copy">
								<strong>{project.name}</strong>
							</span>
							<span class="arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>

			<section class="tab-panel" id="about-panel" role="tabpanel" aria-labelledby="about-tab" hidden>
				<h2>关于</h2>
				<dl class="info-list">
					<div><dt>Name</dt><dd>Liu Yuanze</dd></div>
					<div><dt>Interest</dt><dd>产品　运营　策划</dd></div>
					<div><dt>Mail</dt><dd><a class="email" href="mailto:3323098520@qq.com">3323098520@qq.com</a></dd></div>
					<div><dt>School</dt><dd>CUMT</dd></div>
				</dl>
				<div class="about-extra">
					<section>
						<a class="resume-link" href={`${base}resume/`} target="_blank" rel="noreferrer">Resume ↗</a>
					</section>
					<section>
						<h3>Visited city</h3>
						<p class="city-list">{visitedCities.join('、')}</p>
					</section>
					<section>
						<h3>Label</h3>
						<div class="tag-list">
							{labels.map((label) => <span>{label}</span>)}
						</div>
					</section>
				</div>
			</section>

			<section class="tab-panel contact-panel" id="contact-panel" role="tabpanel" aria-labelledby="contact-tab" hidden>
				<h2>联系我</h2>
				<p class="contact-copy">可以通过邮箱联系，或扫描下方二维码添加微信。</p>
				<a class="email contact-email" href="mailto:3323098520@qq.com">3323098520@qq.com</a>
				<figure>
					<img src={wechatUrl} alt="暮春十九的微信二维码" width="1120" height="1622" />
					<figcaption>扫码添加微信</figcaption>
				</figure>
			</section>

			<footer>© 2026 · 个人主页</footer>
		</main>
	</body>
</html>

<script>
	const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
	const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));

	function activateTab(name) {
		for (const tab of tabs) {
			const selected = tab instanceof HTMLElement && tab.dataset.tab === name;
			tab.setAttribute('aria-selected', String(selected));
		}

		for (const panel of panels) {
			if (panel instanceof HTMLElement) {
				panel.hidden = panel.id !== `${name}-panel`;
			}
		}

		history.replaceState(null, '', `#${name}`);
	}

	for (const tab of tabs) {
		tab.addEventListener('click', () => {
			if (tab instanceof HTMLElement && tab.dataset.tab) activateTab(tab.dataset.tab);
		});
	}

	const initialTab = location.hash.slice(1);
	if (['home', 'about', 'contact'].includes(initialTab)) activateTab(initialTab);
</script>

<style>
	:global(*) { box-sizing: border-box; }
	:global([hidden]) { display: none !important; }
	:global(body) {
		margin: 0;
		color: #44494c;
		background: #fdfdfb;
		font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
	}

	main {
		width: min(760px, calc(100% - 40px));
		margin: 0 auto;
		padding: 72px 0 40px;
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 28px;
		padding-bottom: 30px;
	}

	.identity {
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.avatar {
		width: 92px;
		height: 92px;
		border: 1px solid #d7d7d3;
		border-radius: 50%;
		object-fit: cover;
	}

	.label {
		margin: 0 0 12px;
		color: #8e745f;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	h1, h2, h3, strong { font-family: Georgia, "Songti SC", "SimSun", serif; }
	h1 { margin: 0; color: #3e4346; font-size: clamp(2.3rem, 8vw, 3.8rem); letter-spacing: -0.04em; }
	.intro { margin: 10px 0 0; color: #858887; }
	.github { padding: 8px 10px; border: 1px solid #d7d7d3; color: #626668; font-size: 0.82rem; text-decoration: none; }
	.github:hover, .project:hover { color: #7b5840; border-color: #bba28f; }

	.tabs {
		display: flex;
		margin-top: 20px;
		border-bottom: 1px solid #dadad6;
	}
	.tab {
		margin: 0 0 -1px;
		padding: 12px 24px;
		border: 1px solid transparent;
		border-bottom: 0;
		color: #555a5c;
		background: transparent;
		font: inherit;
		font-size: 0.88rem;
		cursor: pointer;
	}
	.tab:hover { color: #7b5840; }
	.tab[aria-selected="true"] { border-color: #dadad6; background: #fdfdfb; color: #34393b; }
	.tab:focus-visible { outline: 2px solid #8e745f; outline-offset: 2px; }

	.tab-panel { min-height: 360px; padding: 36px 0 6px; }
	h2 { margin: 0 0 20px; color: #44494c; font-size: 1.25rem; }
	.info-list { margin: 0; }
	.info-list div { display: grid; grid-template-columns: 110px 1fr; padding: 13px 0; border-bottom: 1px solid #e4e3df; }
	dt { color: #777b7c; font-size: 0.86rem; }
	dd { margin: 0; color: #999b9b; font-size: 0.86rem; }
	.email { color: #626668; text-decoration: none; }
	.email:hover { color: #7b5840; text-decoration: underline; }
	.about-extra { margin-top: 32px; }
	.about-extra section { padding: 0 0 24px; margin-bottom: 24px; border-bottom: 1px solid #e4e3df; }
	.about-extra h3 { margin: 0 0 12px; color: #44494c; font-size: 1.08rem; }
	.about-extra p { margin: 0; color: #999b9b; font-size: 0.86rem; }
	.resume-link { color: #44494c; font-size: 1.08rem; font-weight: 700; text-decoration: none; }
	.resume-link:hover { color: #7b5840; }
	.about-extra .city-list { color: #676c6e; line-height: 1.9; }
	.tag-list { display: flex; flex-wrap: wrap; gap: 8px; }
	.tag-list span { padding: 5px 9px; border: 1px solid #d9d8d4; color: #676c6e; font-size: 0.8rem; }

	.project-list { border-top: 1px solid #dcdcd8; }
	.project {
		display: grid;
		grid-template-columns: 46px 1fr auto;
		gap: 16px;
		align-items: center;
		padding: 22px 0;
		border-bottom: 1px solid #dcdcd8;
		color: inherit;
		text-decoration: none;
	}
	.number { color: #a08d7f; font-size: 0.75rem; }
	.project-copy { display: grid; }
	.project-copy strong { font-size: 1.12rem; }
	.arrow { font-size: 1rem; }
	.contact-copy { margin: 0 0 8px; color: #7d8182; line-height: 1.7; }
	.contact-email { display: inline-block; margin-bottom: 24px; }
	figure { width: min(360px, 100%); margin: 0; }
	figure img { display: block; width: 100%; height: auto; border: 1px solid #e3e3df; }
	figcaption { margin-top: 10px; color: #9b9d9c; font-size: 0.75rem; text-align: center; }
	footer { margin-top: 56px; padding-top: 20px; border-top: 1px solid #dadad6; color: #a0a19f; font-size: 0.75rem; }

	@media (max-width: 560px) {
		main { width: min(100% - 28px, 760px); padding-top: 38px; }
		header { flex-direction: column; padding-bottom: 30px; }
		.identity { align-items: flex-start; gap: 16px; }
		.avatar { width: 74px; height: 74px; }
		.tab { flex: 1; padding: 11px 10px; }
		.info-list div { grid-template-columns: 90px 1fr; }
		.project { grid-template-columns: 34px 1fr auto; gap: 10px; }
	}
</style>
