---
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project, index) => ({
		params: { slug: project.slug },
		props: { project, number: index + 1 },
	}));
}

type Project = (typeof projects)[number];
const { project, number } = Astro.props as { project: Project; number: number };
const base = `${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, '/');
const pageUrl = `https://3323098520.github.io${base}projects/${project.slug}/`;
const projectImage = 'image' in project ? `${base}${project.image}` : undefined;
const projectImageUrl = projectImage ? `https://3323098520.github.io${projectImage}` : undefined;
const projectImageAlt = 'imageAlt' in project ? project.imageAlt : '';
const projectImageWidth = 'imageWidth' in project ? project.imageWidth : undefined;
const projectImageHeight = 'imageHeight' in project ? project.imageHeight : undefined;
const pageDescription = `${project.name}。具体内容后续再补，敬请期待。`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={project.name} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={pageUrl} />
		{projectImageUrl && <meta property="og:image" content={projectImageUrl} />}
		<meta name="twitter:card" content={projectImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={project.name} />
		<meta name="twitter:description" content={pageDescription} />
		{projectImageUrl && <meta name="twitter:image" content={projectImageUrl} />}
		<title>{project.name}｜暮春十九✨</title>
	</head>
	<body>
		<main>
			<a class="back" href={`${base}#home`}>← 返回首页</a>
			<p class="label">PROJECT 0{number}</p>
			<h1>{project.name}</h1>
			{projectImage && (
				<figure>
					<img src={projectImage} alt={projectImageAlt} width={projectImageWidth} height={projectImageHeight} />
				</figure>
			)}
			<p class="coming-soon">具体内容后续再补，敬请期待。</p>
		</main>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; color: #44494c; background: #fdfdfb; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; }
	main { width: min(760px, calc(100% - 40px)); min-height: 100vh; margin: 0 auto; padding: 72px 0; }
	.back { display: inline-block; margin-bottom: 72px; color: #777b7c; font-size: 0.84rem; text-decoration: none; }
	.back:hover { color: #7b5840; }
	.label { margin: 0 0 14px; color: #8e745f; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; }
	h1 { max-width: 680px; margin: 0; color: #3e4346; font-family: Georgia, "Songti SC", "SimSun", serif; font-size: clamp(2rem, 7vw, 3.4rem); line-height: 1.3; }
	figure { margin: 40px 0 0; }
	figure img { display: block; width: 100%; height: auto; border: 1px solid #dadad6; border-radius: 8px; box-shadow: 0 14px 38px rgb(56 64 61 / 10%); }
	.coming-soon { margin: 30px 0 0; padding-top: 24px; border-top: 1px solid #dadad6; color: #858887; line-height: 1.8; }
	@media (max-width: 560px) { main { width: min(100% - 28px, 760px); padding-top: 38px; } .back { margin-bottom: 48px; } }
</style>
