---
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.filter((project) => !('externalUrl' in project)).map((project, index) => ({
		params: { slug: project.slug },
		props: { project, number: index + 1 },
	}));
}

type Project = (typeof projects)[number];
const { project, number } = Astro.props as { project: Project; number: number };
const base = `${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, '/');
const pageUrl = `https://3323098520.github.io${base}projects/${project.slug}/`;
const projectImages = project.images.map((image) => ({
	...image,
	src: `${base}${image.src}`,
}));
const primaryImageUrl = `https://3323098520.github.io${projectImages[0].src}`;
const showComingSoon = project.slug !== 'field-pest-monitoring';
const pageDescription = showComingSoon ? `${project.name}。具体内容后续再补，敬请期待。` : project.name;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={project.name} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={primaryImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={project.name} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={primaryImageUrl} />
		<title>{project.name}｜暮春十九✨</title>
	</head>
	<body>
		<main>
			<a class="back" href={`${base}#home`}>← 返回首页</a>
			<p class="label">PROJECT 0{number}</p>
			<h1>{project.name}</h1>
			<div class="project-gallery" data-project={project.slug} aria-label="项目图片">
				{projectImages.map((image) => (
					<figure>
						<div class="protected-image">
							<img src={image.src} alt={image.alt} width={image.width} height={image.height} draggable="false" />
						</div>
					</figure>
				))}
			</div>
			{showComingSoon && <p class="coming-soon">具体内容后续再补，敬请期待。</p>}
		</main>
	</body>
</html>

<script>
	const protectedImages = document.querySelectorAll('.protected-image');
	protectedImages.forEach((container) => {
		['contextmenu', 'dragstart', 'copy', 'cut', 'selectstart'].forEach((eventName) => {
			container.addEventListener(eventName, (event) => event.preventDefault());
		});
	});

	document.addEventListener('keydown', (event) => {
		if ((event.ctrlKey || event.metaKey) && ['p', 's', 'u'].includes(event.key.toLowerCase())) {
			event.preventDefault();
		}
	});
</script>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; color: #44494c; background: #fdfdfb; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; }
	main { width: min(760px, calc(100% - 40px)); min-height: 100vh; margin: 0 auto; padding: 72px 0; }
	.back { display: inline-block; margin-bottom: 72px; color: #777b7c; font-size: 0.84rem; text-decoration: none; }
	.back:hover { color: #7b5840; }
	.label { margin: 0 0 14px; color: #8e745f; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; }
	h1 { max-width: 680px; margin: 0; color: #3e4346; font-family: Georgia, "Songti SC", "SimSun", serif; font-size: clamp(2rem, 7vw, 3.4rem); line-height: 1.3; }
	.project-gallery { display: grid; gap: 32px; margin-top: 40px; }
	@media (min-width: 700px) {
		.project-gallery[data-project="field-pest-monitoring"] { grid-template-columns: minmax(0, 0.44fr) minmax(0, 0.56fr); gap: 16px; }
		.project-gallery[data-project="field-pest-monitoring"] figure:first-child { grid-row: 1 / span 2; }
	}
	figure { margin: 0; }
	.protected-image { position: relative; overflow: hidden; border: 1px solid #dadad6; border-radius: 8px; box-shadow: 0 14px 38px rgb(56 64 61 / 10%); user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
	.protected-image::after { content: "仅供作品集展示 · 禁止转载"; position: absolute; right: 12px; bottom: 10px; padding: 5px 9px; border-radius: 4px; color: rgb(255 255 255 / 88%); background: rgb(20 28 31 / 48%); font-size: 0.68rem; letter-spacing: 0.06em; pointer-events: none; }
	.protected-image img { display: block; width: 100%; height: auto; pointer-events: none; user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
	.coming-soon { margin: 30px 0 0; padding-top: 24px; border-top: 1px solid #dadad6; color: #858887; line-height: 1.8; }
	@media print { .project-gallery { display: none; } }
	@media (max-width: 560px) { main { width: min(100% - 28px, 760px); padding-top: 38px; } .back { margin-bottom: 48px; } }
</style>
