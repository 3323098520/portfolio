---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

type Project = (typeof projects)[number];
const { project } = Astro.props as { project: Project };
const base = `${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, '/');
---

<BaseLayout title={`${project.title}｜个人作品集`} description={project.summary} active="项目" includeOgImage={false}>
	<main class="detail-page">
		<a class="back-link" href={`${base}#projects`}>← 返回项目列表</a>
		<header class="detail-header">
			<p class="eyebrow">PROJECT {project.order}</p>
			<h1>{project.title}</h1>
			<p>{project.summary}</p>
			<ul class="tags" aria-label="项目标签">
				{project.tags.map((tag) => <li>{tag}</li>)}
			</ul>
		</header>
		<div class="detail-grid">
			<section><span>01</span><div><h2>项目背景</h2><p>待补充项目所处场景、目标用户与问题来源。</p></div></section>
			<section><span>02</span><div><h2>我的职责</h2><p>待补充个人负责范围、协作边界与实际投入。</p></div></section>
			<section><span>03</span><div><h2>分析与过程</h2><p>待补充调研、分析、设计和关键决策过程。</p></div></section>
			<section><span>04</span><div><h2>方案与产出</h2><p>待补充最终方案、原型、文档或数据分析成果。</p></div></section>
			<section><span>05</span><div><h2>结果与证据</h2><p>待补充可以核实的测试、反馈或项目结果。</p></div></section>
			<section><span>06</span><div><h2>项目复盘</h2><p>待补充项目中的收获、限制与下一步改进。</p></div></section>
		</div>
	</main>
</BaseLayout>
